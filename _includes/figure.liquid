{% comment %}
  Responsive image. If WebP copies of the image exist next to it
  (e.g. Mengmei_Ye-480.webp, -800.webp, -1400.webp for Mengmei_Ye.jpeg),
  browsers pick the best size; otherwise the original file is shown.
  See README.md for how to regenerate the WebP copies.
{% endcomment %}
{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
{% capture first_webp %}/{{ img_path }}-{{ site.responsive_image_widths.first }}.webp{% endcapture %}
{% assign has_webp = site.static_files | where: 'path', first_webp | size %}

<figure>
  <picture>
    {% if has_webp > 0 %}
      <source
        class="responsive-img-srcset"
        srcset="{% for i in site.responsive_image_widths %}{{ img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
        type="image/webp"
        sizes="{{ include.sizes | default: '95vw' }}"
      >
    {% endif %}
    <img
      src="{% if include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      width="100%"
      height="auto"
      {% if include.alt %}
        alt="{{ include.alt }}"
      {% endif %}
      loading="{{ include.loading | default: 'lazy' }}"
      onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
    >
  </picture>
</figure>
